{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DocQuery": {
    "DefaultProfile": "Local",
    "Profiles": {
      "Local": {
        "DisplayName": "Local (Llama 3 8B)",
        "Type": "Local"
      },
      "Spark": {
        "DisplayName": "DGX Spark (Llama 3 70B)",
        "Type": "Local",
        "Hint": "~20 s per answer",
        "Ollama": {
          "BaseUrl": "http://localhost:11435",
          "ChatModel": "llama3:70b"
        }
      },
      "Azure": {
        "DisplayName": "Azure (gpt-5-mini)",
        "Type": "Azure"
      }
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "EmbeddingModel": "nomic-embed-text",
      "ChatModel": "llama3"
    },
    "ChromaDb": {
      "BaseUrl": "http://localhost:8000"
    },
    "Azure": {
      "OpenAI": {
        "Endpoint": "https://YOUR_RESOURCE.openai.azure.com/",
        "ApiKey": "YOUR_KEY",
        "ChatDeployment": "gpt-5-mini",
        "EmbeddingDeployment": "text-embedding-3-small",
        "MaxOutputTokens": null
      },
      "Search": {
        "Endpoint": "https://YOUR_RESOURCE.search.windows.net",
        "ApiKey": "YOUR_KEY",
        "IndexName": "docquery-index"
      }
    },
    "Cors": {
      "AllowedOrigins": ["http://localhost:3000"]
    },
    "Demo": {
      "Enabled": false,
      "SeedPath": "../../docs/samples",
      "RateLimitPerMinute": 20,
      "PresetQuestions": [
        "What is DocQuery and how does it work?",
        "What documents are in this corpus?"
      ]
    }
  }
}
